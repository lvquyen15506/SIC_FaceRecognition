# Frontend Dockerfile for SIC_FaceRecognition
FROM node:18-alpine as build

WORKDIR /app
COPY web_app/frontend/package*.json ./ 2>/dev/null || true
COPY web_app/frontend /app

# Serve with lightweight static server or Nginx
FROM nginx:alpine
COPY web_app/frontend /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
